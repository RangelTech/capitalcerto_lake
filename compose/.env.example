# Exemplo, nenhum valor real aqui. O .env de verdade e gerado pelo Terraform (ver
# terraform/main.tf, resource local_file.compose_env) a partir de compose/.env.tftpl e nunca e
# commitado (ver .gitignore).

TZ=America/Sao_Paulo

ROOT_DOMAIN=
LETSENCRYPT_EMAIL=

SHARED_ADMIN_USER=admin@example.com
SHARED_ADMIN_PASSWORD=change-me

POSTGRES_VERSION=16
POSTGRES_ADMIN_PASSWORD=change-me

MINIO_VERSION=latest
MINIO_ROOT_USER=admin@example.com
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKETS=raw,trusted,analytics

CLICKHOUSE_VERSION=latest
CLICKHOUSE_PASSWORD=change-me

AIRFLOW_VERSION=2.9.3
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_ADMIN_USER=admin@example.com
AIRFLOW_ADMIN_PASSWORD=change-me

METABASE_VERSION=latest
METABASE_DB_PASSWORD=change-me

NINEROUTER_VERSION=latest
NINEROUTER_API_KEYS=change-me

RISK_API_SECRET_KEY=change-me

UPTIME_KUMA_VERSION=latest

TRAEFIK_VERSION=v3.1
TRAEFIK_BASIC_AUTH_USER=admin@example.com
TRAEFIK_BASIC_AUTH_PASSWORD=change-me
